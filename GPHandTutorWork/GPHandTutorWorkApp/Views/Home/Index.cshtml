
@{
    ViewData["Title"] = "Home Page";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<div class="text-center">
    <h1 class="display-4">Документы</h1>
</div>

<div class="text-center">
    @{
        if (Model == null) {
            <h3 class="display-4">Авторизируйтесь</h3>
            return;
        }

        <table class="table">
            <thead>
                <tr>
                    <th>
                        Номер
                    </th>
                    <th>
                        Наименование
                    </th>
                    <th>
                        Создал
                    </th>
                    <th>
                        Формат документа
                    </th>
                    <th>
                        Тип документа
                    </th>
                    <th>
                        Дата
                    </th>
                </tr>
            </thead>
        </table>
    }
</div>
