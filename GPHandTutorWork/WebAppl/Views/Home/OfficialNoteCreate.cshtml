@{
    ViewData["Title"] = "OfficialNote";
}

<div class="text-center">
    <h2 class="display-4">Записки сотрудника</h2>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}

<form method="post">
    <input type="hidden" name="id" value="@ViewBag.Text?.Id" />
    <input type="hidden" name="action" id="action" value="" />

    <div class="row">
        <div class="col-4">Тело письма:</div>
        <div class="col-8">
            <textarea name="comment"
                      id="autoResizeTextarea"
                      style="width: 100%; min-height: 40px; padding: 5px; resize: none;"
                      placeholder="Введите текст...">@ViewBag.Text?.Comment</textarea>
        </div>
    </div>
    <div class="row">
        <div class="col-8"></div>
        <div class="col-4">
            @if (ViewBag.Text?.Id > 0 && ViewBag.Text?.Comment != null)
            {
                <a href="@Url.Action("CreateWordReport", "Home", new { id = ViewBag.Text?.Id, comment = ViewBag.Text?.Comment })" class="btn btn-success">Скачать</a>
                <input type="submit" value="Удалить" class="btn btn-danger" onclick="setAction('delete')" />
            }
            <input type="submit" value="Сохранить" class="btn btn-primary" onclick="setAction('save')" />
        </div>
    </div>
</form>

<script>
    const textarea = document.getElementById('autoResizeTextarea');

    textarea.addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = (this.scrollHeight) + 'px';
    });

    window.addEventListener('load', function () {
        textarea.style.height = 'auto';
        textarea.style.height = (textarea.scrollHeight) + 'px';
    });

    function setAction(action) {
        document.getElementById('action').value = action;
    }
</script>