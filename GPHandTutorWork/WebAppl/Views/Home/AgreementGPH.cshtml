@{
    ViewData["Title"] = "AgreementGPH";
}
<div class="text-center">
    <h2 class="display-4">Создание ГПХ</h2>
</div>
<form method="post">
    <div class="row">
        <div class="col-4">Предмет:</div>
        <div class="col-8">
            <select id="SubjectName" name="SubjectName" class="form-control">
                <option value="">Выберите группу</option>
                @foreach (var group in ViewBag.Groups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-4">Группа:</div>
        <div class="col-8">
            <select id="group" name="group" class="form-control">
                <option value="">Выберите группу</option>
                @foreach (var group in ViewBag.Groups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="col-auto">
        <input type="date" class="form-control" placeholder="Дата начала" name="datestart">
    </div>
    <div class="col-auto">
        <input type="date" class="form-control" placeholder="Дата конца" name="dateend">
    </div>
   <div class="col-auto">
       <input type="number" class="form-control" placeholder="Оплата в час" name="bet" />
   </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <p>
        <a asp-action="ProgressControllStudent" asp-route-StudentID="" id="createLink">Проверить оценки</a>
    </p>

</form>

