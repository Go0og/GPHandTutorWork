@using Contracts.ViewContract
@model List<GPHAgreementViewModel> 
@{
    ViewData["Title"] = "AgreementGPH";
}

<div class="text-center">
    <h2 class="display-4">Заключенные ГПХ</h2>
</div>
<div class="text-center">
    @{
        if (Model == null)
        {
            <h3 class="display-4">Авторизируйтесь</h3>
            return;
        }
        <div class="row">
            <div class="col-4">Номер редактируемой записи:</div>
            <div class="col-8"><input type="number" id="GPH_id" name="GPH_id" min="1" /></div>
        </div>
        <p>
            <a asp-action="AgreementGPH_Create" asp-route-Note_id="" id="createLink">Работать с запиской</a>
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Предмет</th>
                    <th>Преподаватель</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@ViewBag.CurriculumNames[item.CurriculumId]</td>
                        <td>@Html.DisplayFor(modelItem => item.TeacherId)</td>
                        <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<script>
    document.getElementById('GPH_id').addEventListener('input', function () {
        const GPH_id = this.value;
        const createLink = document.getElementById('createLink');
        createLink.href = `@Url.Action("AgreementGPH_Create")?GPH_Id=${GPH_id}`;
    });
</script>