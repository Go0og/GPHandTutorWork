@{
    ViewData["Title"] = "AgreementGPH_Create";
}
<div class="text-center">
    <h2 class="display-4">Создание ГПХ</h2>
</div>
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}
<form method="post">
    <div class="row">
        <div class="col-4">Предмет:</div>
        <div class="col-8">
            <select id="subject" name="subject" class="form-control">
                @if (ViewBag.gph_data != null)
                {
                    <option value="@ViewBag.gph_data.CurriculumId">@ViewBag.CurriculumNames[ViewBag.gph_data.CurriculumId]</option>
                }
                else
                {
                    <option value="">Выберите предмет</option>
                }

                @foreach (var subject in ViewBag.subject)
                {
                    <option value="@subject">@subject</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-4">Группа:</div>
        <div class="col-8">
            <select id="group" name="group" class="form-control">
                <option value="">Выберите группу</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-4">Преподаватель:</div>
        <div class="col-8">
            <select id="teacher" name="teacher" class="form-control">
                <option value="">Выберите преподавателя</option>
                @foreach (var teacher in ViewBag.teachers)
                {
                    <option value="@teacher.Id">@teacher.FIO</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-4">Семестр:</div>
        <div class="col-8">
            <select id="term" name="term" class="form-control">
                <option value="">Выберите семестр</option>
            </select>
        </div>
    </div>    <div class="col-auto">
        <input type="date" class="form-control" placeholder="Дата начала" name="datestart" value="@(ViewBag.gph_data != null ? ViewBag.DateStart : "")">
    </div>
    <div class="col-auto">
        <input type="date" class="form-control" placeholder="Дата конца" name="dateend" value="@(ViewBag.gph_data != null ? ViewBag.DateEnd : "")">
    </div>
    <div class="col-auto">
        <input type="number" class="form-control" placeholder="Оплата в час" name="bet" value="@(ViewBag.gph_data != null ? ViewBag.Bet : "")" />
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <input type="submit" value="Сохранить" class="btn btn-primary" onclick="setAction('save')" />

</form>

<script>
    $(document).ready(function() {
        // Проверяем, есть ли данные о ГПХ
    @if (ViewBag.gph_data != null)
    {
        <text>
                // Устанавливаем значение предмета и триггерим событие change
                $('#subject').val('@ViewBag.gph_data.CurriculumId').trigger('change');

                // Устанавливаем значение группы после загрузки групп
                setTimeout(function() {
                    $('#group').val('@ViewBag.SelectedGroup');
                    loadGroupName('@ViewBag.SelectedGroup'); // Загружаем название группы по ID
                }, 500); // Небольшая задержка для гарантии загрузки групп

                // Устанавливаем значение преподавателя
                $('#teacher').val('@ViewBag.SelectedTeacher');
                loadTeacherName('@ViewBag.SelectedTeacher'); // Загружаем ФИО преподавателя по ID

                // Устанавливаем значение семестра после загрузки семестров
                setTimeout(function() {
                    $('#term').val('@ViewBag.SelectedTerm');
                    loadTermName('@ViewBag.SelectedTerm'); // Загружаем название семестра по ID
                }, 1000); // Задержка для гарантии загрузки семестров
        </text>
    }

        // Обработчик изменения предмета
        $('#subject').change(function() {
            loadGroups();
        });

        // Обработчик изменения группы
        $('#group').change(function() {
            loadTerms();
        });

        // Функция загрузки групп
        function loadGroups() {
            var subject = $('#subject').val();
            if (subject) {
                $.ajax({
                    url: '@Url.Action("GetGroupsBySubject", "Home")',
                    type: 'GET',
                    data: { subject: subject },
                    success: function(data) {
                        $('#group').empty();
                        $('#group').append('<option value="">Выберите группу</option>');
                        $.each(data, function(index, group) {
                            $('#group').append('<option value="' + group.id + '">' + group.name + '</option>');
                        });
                        // Если есть выбранная группа, устанавливаем её значение
    @if (ViewBag.gph_data != null)
    {
        <text>
                                $('#group').val('@ViewBag.SelectedGroup');
                                loadGroupName('@ViewBag.SelectedGroup'); // Загружаем название группы по ID
        </text>
    }
                    }
                });
            } else {
                $('#group').empty();
                $('#group').append('<option value="">Выберите группу</option>');
            }
        }

        // Функция загрузки названия группы по ID
        function loadGroupName(groupId) {
            if (groupId) {
                $.ajax({
                    url: '@Url.Action("GetGroupNameById", "Home")', // Новый метод в контроллере
                    type: 'GET',
                    data: { groupId: groupId },
                    success: function(data) {
                        $('#group option[value="' + groupId + '"]').text(data); // Обновляем текст option
                    }
                });
            }
        }

        // Функция загрузки семестров
        function loadTerms() {
            var groupId = $('#group').val();
            var subject = $('#subject').val();
            if (groupId && subject) {
                $.ajax({
                    url: '@Url.Action("GetTermsByGroupAndSubject", "Home")',
                    type: 'GET',
                    data: { groupId: groupId, subject: subject },
                    success: function(data) {
                        $('#term').empty();
                        $('#term').append('<option value="">Выберите семестр</option>');
                        $.each(data, function(index, term) {
                            $('#term').append('<option value="' + term.id + '">' + term.name + '</option>');
                        });
                        // Если есть выбранный семестр, устанавливаем его значение
    @if (ViewBag.gph_data != null)
    {
        <text>
                                $('#term').val('@ViewBag.SelectedTerm');
                                loadTermName('@ViewBag.SelectedTerm'); // Загружаем название семестра по ID
        </text>
    }
                    }
                });
            } else {
                $('#term').empty();
                $('#term').append('<option value="">Выберите семестр</option>');
            }
        }

        // Функция загрузки названия семестра по ID
        function loadTermName(termId) {
            if (termId) {
                $.ajax({
                    url: '@Url.Action("GetTermNameById", "Home")', // Новый метод в контроллере
                    type: 'GET',
                    data: { termId: termId },
                    success: function(data) {
                        $('#term option[value="' + termId + '"]').text(data); // Обновляем текст option
                    }
                });
            }
        }

        // Функция загрузки ФИО преподавателя по ID
        function loadTeacherName(teacherId) {
            if (teacherId) {
                $.ajax({
                    url: '@Url.Action("GetTeacherNameById", "Home")', // Новый метод в контроллере
                    type: 'GET',
                    data: { teacherId: teacherId },
                    success: function(data) {
                        $('#teacher option[value="' + teacherId + '"]').text(data); // Обновляем текст option
                    }
                });
            }
        }
    });
</script>