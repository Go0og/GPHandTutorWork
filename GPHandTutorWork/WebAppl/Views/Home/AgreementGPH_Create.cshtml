@{
    ViewData["Title"] = "AgreementGPH_Create";
}
<div class="text-center">
    <h2 class="display-4">Работа с ГПХ</h2>
</div>
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}
<form method="post">
    <input type="hidden" name="id" value="@ViewBag.gph_data?.Id" />
    <div class="row">
        <div class="col-4">Предмет:</div>
        <div class="col-8">
            <select id="subject" name="subject" class="form-control">
                <option value="">Выберите предмет</option>
                @foreach (var subject in ViewBag.subject)
                {
                    <option value="@subject">@subject</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-4">Группа:</div>
        <div class="col-8">
            <select id="group" name="group" class="form-control">
                <option value="">Выберите группу</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-4">Преподаватель:</div>
        <div class="col-8">
            <select id="teacher" name="teacher" class="form-control">
                <option value="">Выберите преподавателя</option>
                @foreach (var teacher in ViewBag.teachers)
                {
                    <option value="@teacher.Id">@teacher.FIO</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-4">Семестр:</div>
        <div class="col-8">
            <select id="term" name="term" class="form-control">
                <option value="">Выберите семестр</option>
            </select>
        </div>
    </div>
    <div class="col-auto">
        <input type="date" class="form-control" placeholder="Дата начала" name="datestart">
    </div>
    <div class="col-auto">
        <input type="date" class="form-control" placeholder="Дата конца" name="dateend">
    </div>
    <div class="col-auto">
        <input type="number" class="form-control" placeholder="Оплата в час" name="bet" />
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @if (ViewBag.gph_data != null)
    {
        <input type="submit" name="action" value="Скачать" class="btn btn-success" />
        <input type="submit" name="action" value="Удалить" class="btn btn-danger" />
    }

    <input type="submit" name="action" value="Сохранить" class="btn btn-primary" />
</form>

@if (ViewBag.gph_data != null)
{
    <div class="card mt-4">
        <div class="card-header">
            <h4>Текущие данные ГПХ</h4>
        </div>
        <div class="card-body">
            <p><strong>Предмет:</strong> @ViewBag.CurriculumNames[ViewBag.gph_data.CurriculumId]</p>
            <p><strong>Группа:</strong> @ViewBag.SelectedGroup</p>
            <p><strong>Преподаватель:</strong> @ViewBag.SelectedTeacher</p>
            <p><strong>Семестр:</strong> @ViewBag.SelectedTerm</p>
            <p><strong>Дата начала:</strong> @ViewBag.DateStart</p>
            <p><strong>Дата конца:</strong> @ViewBag.DateEnd</p>
            <p><strong>Оплата в час:</strong> @ViewBag.Bet</p>
        </div>
    </div>
}

<script>
    $(document).ready(function() {
        $('#subject').change(function() {
            loadGroups();
        });

        $('#group').change(function() {
            loadTerms();
        });

        function loadGroups() {
            var subject = $('#subject').val();
            if (subject) {
                $.ajax({
                    url: '@Url.Action("GetGroupsBySubject", "Home")',
                    type: 'GET',
                    data: { subject: subject },
                    success: function(data) {
                        $('#group').empty();
                        $('#group').append('<option value="">Выберите группу</option>');
                        $.each(data, function(index, group) {
                            $('#group').append('<option value="' + group.id + '">' + group.name + '</option>');
                        });
                        $('#group').trigger('change');
                    }
                });
            } else {
                $('#group').empty();
                $('#group').append('<option value="">Выберите группу</option>');
            }
        }

        function loadTerms() {
            var groupId = $('#group').val();
            var subject = $('#subject').val();
            if (groupId && subject) {
                $.ajax({
                    url: '@Url.Action("GetTermsByGroupAndSubject", "Home")',
                    type: 'GET',
                    data: { groupId: groupId, subject: subject },
                    success: function(data) {
                        $('#term').empty();
                        $('#term').append('<option value="">Выберите семестр</option>');
                        $.each(data, function(index, term) {
                            $('#term').append('<option value="' + term + '">' + term + '</option>');
                        });
                    }
                });
            } else {
                $('#term').empty();
                $('#term').append('<option value="">Выберите семестр</option>');
            }
        }
    });
</script>