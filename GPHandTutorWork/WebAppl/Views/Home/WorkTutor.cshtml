@using Contracts.ViewContract
@model List<WorkTutorViewModel>
@{
    ViewData["Title"] = "WorkTutor";
}

<div class="text-center">
    <h2 class="display-4">Работа куратора</h2>
</div>
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}
<form method="post" class="d-flex justify-content-center mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <input type="date" class="form-control" placeholder="Дата начала" name="datestart" value="@(ViewBag.DateStart != null ? ((DateTime)ViewBag.DateStart).ToString("yyyy-MM-dd") : "")">
        </div>
        <div class="col-auto">
            <input type="date" class="form-control" placeholder="Дата конца" name="dateend" value="@(ViewBag.DateEnd != null ? ((DateTime)ViewBag.DateEnd).ToString("yyyy-MM-dd") : "")">
        </div>
        <div class="col-auto">
            <input type="submit" name="action" value="Фильтровать" class="btn btn-secondary">
        </div>
        <div class="col-auto">
            <input type="submit" name="action" value="Скачать" class="btn btn-primary">
        </div>
    </div>
</form>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Номер</th>
                        <th>Вид работы</th>
                        <th>Дата</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.TypeWork)</td>
                            <td>@Html.DisplayFor(modelItem => item.DateWork)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>